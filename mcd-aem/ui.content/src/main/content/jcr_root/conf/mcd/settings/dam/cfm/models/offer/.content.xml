<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam/mcd/offers(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/mcd/settings/dam/cfm/models/offer/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:primaryType="cq:PageContent"
        jcr:title="Offer"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default">
        <model
            cq:targetPath="/content/dam/mcd/offers"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="50">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="50">
                        <offerId
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Offer ID"
        fieldLabel="Offer ID"
        listOrder="1"
        metaType="text-single"
        name="offerId"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        required="{Boolean}true"/>
                        <title
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Title"
        fieldLabel="Title"
        listOrder="2"
        metaType="text-single"
        name="title"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        required="{Boolean}true"/>
                        <description
        jcr:primaryType="nt:unstructured"
        sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
        cfm-element="Description"
        fieldLabel="Description"
        listOrder="3"
        metaType="text-multi"
        name="description"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"/>
                        <offerType
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Offer type"
        fieldLabel="Offer type"
        listOrder="4"
        metaType="text-single"
        name="offerType"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        emptyText="FIXED_DISCOUNT | PERCENT_DISCOUNT | BOGO | FREE_DELIVERY"/>
                        <value
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
        cfm-element="Value"
        fieldLabel="Value"
        listOrder="5"
        metaType="number"
        name="value"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="long"
        typeHint="long"/>
                        <currency
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Currency (ISO 4217)"
        fieldLabel="Currency (ISO 4217)"
        listOrder="6"
        metaType="text-single"
        name="currency"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        maxlength="3"/>
                        <promoCode
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Promo code"
        fieldLabel="Promo code"
        listOrder="7"
        metaType="text-single"
        name="promoCode"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"/>
                        <startAt
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
        cfm-element="Starts at"
        fieldLabel="Starts at"
        listOrder="8"
        metaType="date"
        name="startAt"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="calendar"
        displayedFormat="YYYY-MM-DD"
        valueFormat="YYYY-MM-DD"
        type="date">
                            <granite:data
                                jcr:primaryType="nt:unstructured"
                                typeHint="Date"/>
                        </startAt>
                        <endAt
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
        cfm-element="Ends at"
        fieldLabel="Ends at"
        listOrder="9"
        metaType="date"
        name="endAt"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="calendar"
        displayedFormat="YYYY-MM-DD"
        valueFormat="YYYY-MM-DD"
        type="date">
                            <granite:data
                                jcr:primaryType="nt:unstructured"
                                typeHint="Date"/>
                        </endAt>
                        <minimumSubtotal
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
        cfm-element="Minimum subtotal"
        fieldLabel="Minimum subtotal"
        listOrder="10"
        metaType="number"
        name="minimumSubtotal"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="long"
        typeHint="long"/>
                        <isActive
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
        cfm-element="Active"
        fieldLabel="Active"
        listOrder="11"
        metaType="boolean"
        name="isActive"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="boolean"
        text="Currently running"/>
                        <image
        jcr:primaryType="nt:unstructured"
        sling:resourceType="dam/cfm/models/editor/components/contentreference"
        cfm-element="Offer artwork"
        fieldLabel="Offer artwork"
        listOrder="12"
        metaType="reference"
        name="image"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        rootPath="/content/dam/mcd"/>
                        <terms
        jcr:primaryType="nt:unstructured"
        sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
        cfm-element="Terms"
        fieldLabel="Terms"
        listOrder="13"
        metaType="text-multi"
        name="terms"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"/>
                        <locale
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Locale (BCP 47)"
        fieldLabel="Locale (BCP 47)"
        listOrder="14"
        metaType="text-single"
        name="locale"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"/>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
