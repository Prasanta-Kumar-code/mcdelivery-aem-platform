<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam/mcd/categories(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/mcd/settings/dam/cfm/models/category/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:primaryType="cq:PageContent"
        jcr:title="Category"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default">
        <model
            cq:targetPath="/content/dam/mcd/categories"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="50">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="50">
                        <title
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Title"
        fieldLabel="Title"
        listOrder="1"
        metaType="text-single"
        name="title"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        required="{Boolean}true"
        maxlength="80"/>
                        <slug
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Slug"
        fieldLabel="Slug"
        listOrder="2"
        metaType="text-single"
        name="slug"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        required="{Boolean}true"/>
                        <description
        jcr:primaryType="nt:unstructured"
        sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
        cfm-element="Description"
        fieldLabel="Description"
        listOrder="3"
        metaType="text-multi"
        name="description"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"/>
                        <image
        jcr:primaryType="nt:unstructured"
        sling:resourceType="dam/cfm/models/editor/components/contentreference"
        cfm-element="Category image"
        fieldLabel="Category image"
        listOrder="4"
        metaType="reference"
        name="image"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        rootPath="/content/dam/mcd"/>
                        <displayOrder
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
        cfm-element="Display order"
        fieldLabel="Display order"
        listOrder="5"
        metaType="number"
        name="displayOrder"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="long"
        required="{Boolean}true"
        typeHint="long"/>
                        <isActive
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
        cfm-element="Active"
        fieldLabel="Active"
        listOrder="6"
        metaType="boolean"
        name="isActive"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="boolean"
        text="Discoverable on the website"/>
                        <locale
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Locale (BCP 47)"
        fieldLabel="Locale (BCP 47)"
        listOrder="7"
        metaType="text-single"
        name="locale"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        required="{Boolean}true"/>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
