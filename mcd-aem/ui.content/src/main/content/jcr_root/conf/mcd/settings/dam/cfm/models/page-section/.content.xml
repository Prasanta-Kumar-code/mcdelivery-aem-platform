<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam/mcd/sections(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/mcd/settings/dam/cfm/models/page-section/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:primaryType="cq:PageContent"
        jcr:title="Page Section"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default">
        <model
            cq:targetPath="/content/dam/mcd/sections"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="50">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="50">
                        <sectionKey
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Section key"
        fieldLabel="Section key"
        listOrder="1"
        metaType="text-single"
        name="sectionKey"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        required="on"
        emptyText="hero | deals | menu | locations"/>
                        <eyebrow
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Eyebrow"
        fieldLabel="Eyebrow"
        listOrder="2"
        metaType="text-single"
        name="eyebrow"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        maxlength="80"/>
                        <heading
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Heading"
        fieldLabel="Heading"
        listOrder="3"
        metaType="text-single"
        name="heading"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        required="on"
        maxlength="120"/>
                        <emptyMessage
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Empty state message"
        fieldLabel="Empty state message"
        listOrder="4"
        metaType="text-single"
        name="emptyMessage"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        maxlength="200"/>
                        <displayOrder
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
        cfm-element="Display order"
        fieldLabel="Display order"
        listOrder="5"
        metaType="number"
        name="displayOrder"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="long"
        required="on"
        typeHint="long"/>
                        <isActive
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
        cfm-element="Active"
        fieldLabel="Active"
        listOrder="6"
        metaType="boolean"
        name="isActive"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="boolean"
        text="Render this section"/>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
