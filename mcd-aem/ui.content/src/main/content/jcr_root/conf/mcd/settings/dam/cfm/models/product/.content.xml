<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0"
    jcr:primaryType="cq:Template"
    allowedPaths="[/content/dam/mcd/products(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/mcd/settings/dam/cfm/models/product/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:primaryType="cq:PageContent"
        jcr:title="Product"
        sling:resourceSuperType="dam/cfm/models/console/components/data/entity"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default">
        <model
            cq:targetPath="/content/dam/mcd/products"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="50">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items
                        jcr:primaryType="nt:unstructured"
                        maxGeneratedOrder="50">
                        <title
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Title"
        fieldLabel="Title"
        listOrder="1"
        metaType="text-single"
        name="title"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        required="on"
        maxlength="160"/>
                        <sku
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="SKU"
        fieldLabel="SKU"
        listOrder="2"
        metaType="text-single"
        name="sku"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        required="on"
        maxlength="64"/>
                        <description
        jcr:primaryType="nt:unstructured"
        sling:resourceType="dam/cfm/admin/components/authoring/contenteditor/multieditor"
        cfm-element="Description"
        fieldLabel="Description"
        listOrder="3"
        metaType="text-multi"
        name="description"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"/>
                        <price
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
        cfm-element="Price"
        fieldLabel="Price"
        listOrder="4"
        metaType="number"
        name="price"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="long"
        required="on"
        typeHint="long"/>
                        <currency
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Currency (ISO 4217)"
        fieldLabel="Currency (ISO 4217)"
        listOrder="5"
        metaType="text-single"
        name="currency"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        maxlength="3"/>
                        <category
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Category slug"
        fieldLabel="Category slug"
        listOrder="6"
        metaType="text-single"
        name="category"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"/>
                        <isVeg
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
        cfm-element="Vegetarian"
        fieldLabel="Vegetarian"
        listOrder="7"
        metaType="boolean"
        name="isVeg"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="boolean"
        text="Vegetarian item"/>
                        <allergens
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Allergens (comma separated)"
        fieldLabel="Allergens (comma separated)"
        listOrder="8"
        metaType="text-single"
        name="allergens"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"/>
                        <availability
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
        cfm-element="Availability"
        fieldLabel="Availability"
        listOrder="9"
        metaType="text-single"
        name="availability"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        emptyText="AVAILABLE | LIMITED | UNAVAILABLE"/>
                        <displayOrder
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
        cfm-element="Display order"
        fieldLabel="Display order"
        listOrder="10"
        metaType="number"
        name="displayOrder"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="long"
        typeHint="long"/>
                        <isActive
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
        cfm-element="Active"
        fieldLabel="Active"
        listOrder="11"
        metaType="boolean"
        name="isActive"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="boolean"
        text="Visible on the website"/>
                        <image
        jcr:primaryType="nt:unstructured"
        sling:resourceType="dam/cfm/models/editor/components/contentreference"
        cfm-element="Product image"
        fieldLabel="Product image"
        listOrder="12"
        metaType="reference"
        name="image"
        renderReadOnly="false"
        showEmptyInReadOnly="true"
        valueType="string"
        rootPath="/content/dam/mcd"/>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
